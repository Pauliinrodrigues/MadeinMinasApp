# Template only. Create /etc/made-in-minas/api.env with owner root, group service, mode 0640.
# Supply actual secrets through the host secret manager; do not commit the completed file.
DOTNET_ENVIRONMENT=Production
ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=loja.example.invalid
Deployment__DatabaseName=made_in_minas_production
ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=5432;Database=made_in_minas_production;Username=made_in_minas_production_app;Password=REPLACE_FROM_SECRET_MANAGER"
Jwt__Issuer=MadeInMinas.Production
Jwt__Audience=MadeInMinas.Production.Staff
Jwt__SigningKey=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_64_BYTES
DataProtection__KeyRingPath=/var/lib/made-in-minas/keys
DataProtection__CertificateFile=/etc/made-in-minas/protection.pfx
DataProtection__CertificatePassword=REPLACE_FROM_SECRET_MANAGER
ProductImages__StoragePath=/var/lib/made-in-minas/product-images
ReverseProxy__KnownProxies__0=127.0.0.1
Ai__Enabled=false
