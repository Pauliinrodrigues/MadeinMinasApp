# Staging only. Protect the completed file with owner root, service group and mode 0640.
# Use its OWN database role, secrets and certificate. Never copy production credentials.
DOTNET_ENVIRONMENT=Staging
ASPNETCORE_ENVIRONMENT=Staging
AllowedHosts=homologacao.loja.example.invalid
Deployment__DatabaseName=made_in_minas_staging
ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=5432;Database=made_in_minas_staging;Username=made_in_minas_staging_app;Password=REPLACE_FROM_STAGING_SECRET_MANAGER"
Jwt__Issuer=MadeInMinas.Staging
Jwt__Audience=MadeInMinas.Staging.Staff
Jwt__SigningKey=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET_OF_AT_LEAST_64_BYTES
DataProtection__KeyRingPath=/var/lib/made-in-minas-staging/keys
DataProtection__CertificateFile=/etc/made-in-minas-staging/protection.pfx
DataProtection__CertificatePassword=REPLACE_FROM_STAGING_SECRET_MANAGER
ProductImages__StoragePath=/var/lib/made-in-minas-staging/product-images
ReverseProxy__KnownProxies__0=127.0.0.1
Ai__Enabled=false
