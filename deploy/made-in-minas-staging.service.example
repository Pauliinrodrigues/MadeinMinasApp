[Unit]
Description=Made in Minas homologacao
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=madeinminas-staging
Group=madeinminas-staging
WorkingDirectory=/opt/made-in-minas-staging/current/api
ExecStart=/usr/bin/dotnet /opt/made-in-minas-staging/current/api/MadeInMinas.Api.dll
Environment=ASPNETCORE_ENVIRONMENT=Staging
Environment=DOTNET_ENVIRONMENT=Staging
Environment=ASPNETCORE_URLS=http://127.0.0.1:5081
EnvironmentFile=/etc/made-in-minas-staging/api.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/made-in-minas-staging

[Install]
WantedBy=multi-user.target
