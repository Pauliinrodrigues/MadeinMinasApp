# Replace domain, certificates and 192.0.2.10 with the team's actual approved IP.
# 192.0.2.10 is a documentation address. Other external clients are denied by default.
# Prefer VPN/access control from the host; keep API and database ports private.
server {
    listen 80;
    server_name homologacao.loja.example.invalid;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name homologacao.loja.example.invalid;
    ssl_certificate /etc/letsencrypt/live/homologacao.loja.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/homologacao.loja.example.invalid/privkey.pem;
    root /opt/made-in-minas-staging/current/frontend;
    index index.html;
    client_max_body_size 9m;
    allow 127.0.0.1;
    allow ::1;
    allow 192.0.2.10;
    deny all;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /api/ {
        proxy_pass http://127.0.0.1:5081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }
    location /health/ {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://127.0.0.1:5081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }
    location ~* \.(js|css|woff2?)$ {
        try_files $uri =404;
        expires 7d;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
