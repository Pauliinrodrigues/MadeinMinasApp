[Unit]
Description=Made in Minas API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=madeinminas
Group=madeinminas
WorkingDirectory=/opt/made-in-minas/current/api
ExecStart=/usr/bin/dotnet /opt/made-in-minas/current/api/MadeInMinas.Api.dll
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
EnvironmentFile=/etc/made-in-minas/api.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/made-in-minas

[Install]
WantedBy=multi-user.target
